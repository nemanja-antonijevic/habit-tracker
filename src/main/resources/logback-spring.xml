<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <springProfile name="local">
        <appender
                name="LOCAL_CONSOLE"
                class="ch.qos.logback.core.ConsoleAppender">

            <encoder
                    class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">

                <pattern>
                    %d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{36} - %msg%n
                </pattern>
            </encoder>
        </appender>

        <logger
                name="com.nantonijevic.habits"
                level="DEBUG"/>

        <root level="INFO">
            <appender-ref ref="LOCAL_CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="prod">
        <appender
                name="PROD_JSON_CONSOLE"
                class="ch.qos.logback.core.ConsoleAppender">

            <encoder
                    class="net.logstash.logback.encoder.LogstashEncoder"/>
        </appender>

        <logger
                name="com.nantonijevic.habits"
                level="INFO"/>

        <root level="WARN">
            <appender-ref ref="PROD_JSON_CONSOLE"/>
        </root>
    </springProfile>

</configuration>
